# Copy to .env and set values for your local PostgreSQL instance.
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillgap_ai

# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
# Email verification defaults on in production; override only when intentional.

# Optional shared rate-limit store for multi-worker deployments; memory:// is per process.
RATE_LIMIT_STORAGE_URI=memory://

# SMTP email delivery for verification and password recovery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Optional frontend page URLs; the API includes the one-time token when these are blank.
EMAIL_VERIFICATION_URL=
PASSWORD_RESET_URL=

# Gemini API (keep the real key only in your local .env file)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
